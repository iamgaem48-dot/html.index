<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For You 🩵</title>
  <!-- Google Fonts: Mitr -->
  <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Mitr', sans-serif;
    }

    body {
      height: 100vh;
      width: 100vw;
      background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 50%, #eff6ff 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      user-select: none;
      position: relative;
    }

    /* Trail Canvas */
    #trailCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 99;
    }

    /* Floating Particles Container */
    #particles-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .floating-particle {
      position: absolute;
      bottom: -60px;
      animation: floatUp linear infinite;
      filter: drop-shadow(0 4px 8px rgba(147, 197, 253, 0.4));
      opacity: 0.8;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) rotate(0deg) scale(0.8);
        opacity: 0;
      }
      15% {
        opacity: 0.85;
      }
      85% {
        opacity: 0.85;
      }
      100% {
        transform: translateY(-115vh) rotate(360deg) scale(1.1);
        opacity: 0;
      }
    }

    /* Main Card Layout */
    .card-wrapper {
      position: relative;
      width: 90%;
      max-width: 420px;
      min-height: 520px;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 10;
    }

    .card {
      position: absolute;
      width: 100%;
      padding: 32px 24px;
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 2px solid rgba(255, 255, 255, 0.9);
      border-radius: 32px;
      box-shadow: 0 20px 40px rgba(147, 197, 253, 0.3),
                  0 0 20px rgba(255, 255, 255, 0.8) inset;
      text-align: center;
      opacity: 0;
      transform: translateY(30px) scale(0.92);
      pointer-events: none;
      transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .card.active {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .icon-box {
      font-size: 52px;
      margin-bottom: 12px;
      display: inline-block;
      animation: bounce 2s infinite ease-in-out;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    h1 {
      color: #1e3a8a;
      font-size: 1.8rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    p.subtitle {
      color: #64748b;
      font-size: 0.95rem;
      font-weight: 300;
      margin-bottom: 20px;
    }

    /* Checklist Styling */
    .checklist {
      background: rgba(240, 249, 255, 0.85);
      border: 1.5px solid #bfdbfe;
      border-radius: 20px;
      padding: 16px;
      margin-bottom: 24px;
      text-align: left;
    }

    .check-item {
      display: flex;
      align-items: center;
      margin-bottom: 12px;
      cursor: pointer;
      font-size: 0.9rem;
      color: #334155;
      transition: transform 0.2s ease;
    }
    .check-item:last-child { margin-bottom: 0; }
    .check-item:hover { transform: translateX(4px); }

    .check-item input { display: none; }

    .checkmark {
      width: 22px;
      height: 22px;
      border: 2px solid #93c5fd;
      border-radius: 7px;
      margin-right: 12px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s ease;
      flex-shrink: 0;
    }

    .check-item input:checked + .checkmark {
      background: #60a5fa;
      border-color: #60a5fa;
      box-shadow: 0 2px 8px rgba(96, 165, 250, 0.4);
    }

    .check-item input:checked + .checkmark::after {
      content: '✓';
      color: white;
      font-size: 14px;
      font-weight: bold;
    }

    .check-item input:checked ~ .label-text {
      color: #94a3b8;
      text-decoration: line-through;
    }

    /* Interactive Area for Card 2 & 3 */
    .interactive-box {
      margin: 20px 0;
      padding: 20px;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 20px;
      border: 1px dashed #93c5fd;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .interactive-box:hover {
      background: rgba(255, 255, 255, 0.9);
      transform: scale(1.03);
    }

    .badge {
      display: inline-block;
      background: #dbeafe;
      color: #1d4ed8;
      padding: 8px 18px;
      border-radius: 50px;
      font-size: 0.95rem;
      font-weight: 500;
      margin-top: 10px;
      box-shadow: 0 4px 12px rgba(191, 219, 254, 0.5);
    }

    /* Buttons */
    .btn-group {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .btn {
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(96, 165, 250, 0.35);
      transition: all 0.3s ease;
      width: 100%;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(96, 165, 250, 0.45);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-secondary {
      background: #e2e8f0;
      color: #475569;
      box-shadow: none;
      width: auto;
    }
    .btn-secondary:hover {
      background: #cbd5e1;
      box-shadow: none;
    }

    /* Custom Message Box for Step 4 */
    .final-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(224,242,254,0.7));
    }
    .final-text {
      font-size: 1.05rem;
      color: #1e3a8a;
      line-height: 1.7;
      margin: 15px 0 25px 0;
    }
  </style>
</head>
<body>

  <!-- Canvas สำหรับ Star Dust Mouse Trail -->
  <canvas id="trailCanvas"></canvas>

  <!-- Container สำหรับวัตถุลอย (กระต่าย/เมฆ/หัวใจ) -->
  <div id="particles-container"></div>

  <main class="card-wrapper">
    
    <!-- STEP 1 -->
    <div class="card active" id="card-1">
      <div class="icon-box">🐰✨</div>
      <h1>ยิ้มหน่อย 🥺</h1>
      <p class="subtitle">ติ๊กเช็กลิสต์ความน่ารัก 4 ข้อนี้ก่อนไปต่อนะ!</p>
      
      <div class="checklist">
        <label class="check-item">
          <input type="checkbox">
          <span class="checkmark"></span>
          <span class="label-text">1. ดื่มน้ำเติมความสดใสหรือยัง 🥛</span>
        </label>
        <label class="check-item">
          <input type="checkbox">
          <span class="checkmark"></span>
          <span class="label-text">2. พักสายตาเว้นช่วงบ้างนะ ☁️</span>
        </label>
        <label class="check-item">
          <input type="checkbox">
          <span class="checkmark"></span>
          <span class="label-text">3. กินของอร่อยๆ เติมพลังหรือยัง 🍰</span>
        </label>
        <label class="check-item">
          <input type="checkbox">
          <span class="checkmark"></span>
          <span class="label-text">4. พร้อมที่จะแจกรอยยิ้มหรือยัง 💖</span>
        </label>
      </div>

      <button class="btn" onclick="goToStep(2)">กดถัดไปเลย ➔</button>
    </div>

    <!-- STEP 2 -->
    <div class="card" id="card-2">
      <div class="icon-box">🐰👀</div>
      <h1>ยิ้มรึยัง?</h1>
      <p class="subtitle">ไหนขอดูหน้าคนเก่งหน่อยเร็ว~</p>
      
      <div class="interactive-box" onclick="triggerHeartBurst(event)">
        <span style="font-size: 40px;">😊</span>
        <p style="font-size: 0.85rem; color: #3b82f6; margin-top: 6px;">(ลองจิ้มตรงนี้เพื่อส่งรอยยิ้ม)</p>
      </div>

      <div class="btn-group">
        <button class="btn btn-secondary" onclick="goToStep(1)">⬅ ย้อนกลับ</button>
        <button class="btn" onclick="goToStep(3)">ถัดไป ➔</button>
      </div>
    </div>

    <!-- STEP 3 -->
    <div class="card" id="card-3">
      <div class="icon-box">🐰💖</div>
      <h1>ยิ้มน่ารักน้ะ ✨</h1>
      <p class="subtitle">รอยยิ้มของคุณทำให้โลกสดใสขึ้นเยอะเลยรู้มั้ยคะ</p>
      
      <div style="margin: 25px 0;">
        <span class="badge">100/10 Cuteness Level! 🌟</span>
      </div>

      <div class="btn-group">
        <button class="btn btn-secondary" onclick="goToStep(2)">⬅ ย้อนกลับ</button>
        <button class="btn" onclick="goToStep(4)">ข้อความสุดท้าย ➔</button>
      </div>
    </div>

    <!-- STEP 4 -->
    <div class="card final-card" id="card-4">
      <div class="icon-box">🐰🎓📚</div>
      <h1 style="color: #1d4ed8;">ตั้งใจทำงานนะ</h1>
      <p class="subtitle" style="font-size: 1.1rem; color: #2563eb; font-weight: 500;">ขอให้คะแนนออกมาดีดี!</p>
      
      <div class="final-text">
        <p>จะคอยเป็นกำลังใจให้อยู่ตรงนี้นะคะ ✨<br>พักผ่อนเยอะๆ สู้ๆ นะคนเก่ง!</p>
      </div>

      <button class="btn" onclick="goToStep(1)" style="background: linear-gradient(135deg, #93c5fd 0%, #3b82f6 100%);">เริ่มใหม่อีกรอบ 🔄</button>
    </div>

  </main>

  <script>
    // --- 1. Step Navigation Logic ---
    function goToStep(stepNumber) {
      const cards = document.querySelectorAll('.card');
      cards.forEach(card => card.classList.remove('active'));
      
      const targetCard = document.getElementById(`card-${stepNumber}`);
      if (targetCard) {
        targetCard.classList.add('active');
      }
    }

    // --- 2. Slow Floating Bunny & Cloud Particles ---
    const particleTypes = ['🐰', '☁️', '🩵', '🤍', '✨', '🐰', '☁️'];
    
    function createFloatingParticle() {
      const container = document.getElementById('particles-container');
      const particle = document.createElement('div');
      particle.className = 'floating-particle';
      particle.innerText = particleTypes[Math.floor(Math.random() * particleTypes.length)];
      
      const startX = Math.random() * window.innerWidth;
      const size = Math.random() * 16 + 20; // Size 20px - 36px
      const duration = Math.random() * 8 + 14; // Duration 14s - 22s (ลอยช้าๆ สบายตา)
      
      particle.style.left = `${startX}px`;
      particle.style.fontSize = `${size}px`;
      particle.style.animationDuration = `${duration}s`;
      
      container.appendChild(particle);
      
      setTimeout(() => {
        particle.remove();
      }, duration * 1000);
    }

    // สร้างอนุภาคลอยเรื่อยๆ
    setInterval(createFloatingParticle, 1100);
    for (let i = 0; i < 7; i++) {
      setTimeout(createFloatingParticle, i * 400);
    }

    // --- 3. Mouse Trail Effect (Star Dust) ---
    const canvas = document.getElementById('trailCanvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let stars = [];

    class Star {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.size = Math.random() * 3.5 + 1.5;
        this.vx = (Math.random() - 0.5) * 1.2;
        this.vy = (Math.random() - 0.5) * 1.2 - 0.3;
        this.alpha = 1;
        this.color = ['#93c5fd', '#bfdbfe', '#ffffff', '#e0f2fe', '#fbcfe8'][Math.floor(Math.random() * 5)];
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= 0.02;
      }

      draw() {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    function addTrail(x, y) {
      for (let i = 0; i < 2; i++) {
        stars.push(new Star(x, y));
      }
    }

    window.addEventListener('mousemove', (e) => addTrail(e.clientX, e.clientY));
    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        addTrail(e.touches[0].clientX, e.touches[0].clientY);
      }
    });

    function animateTrail() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = stars.length - 1; i >= 0; i--) {
        stars[i].update();
        stars[i].draw();
        if (stars[i].alpha <= 0) {
          stars.splice(i, 1);
        }
      }
      requestAnimationFrame(animateTrail);
    }
    animateTrail();

    // --- 4. Interactive Heart Pop Effect ---
    function triggerHeartBurst(e) {
      const container = document.getElementById('particles-container');
      for (let i = 0; i < 8; i++) {
        const heart = document.createElement('div');
        heart.innerText = '🩵';
        heart.style.position = 'fixed';
        heart.style.left = `${e.clientX || window.innerWidth/2}px`;
        heart.style.top = `${e.clientY || window.innerHeight/2}px`;
        heart.style.fontSize = '24px';
        heart.style.pointerEvents = 'none';
        heart.style.transition = 'all 1s ease-out';
        heart.style.zIndex = '100';
        
        container.appendChild(heart);

        setTimeout(() => {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.random() * 80 + 40;
          heart.style.transform = `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist - 50}px) scale(1.3)`;
          heart.style.opacity = '0';
        }, 20);

        setTimeout(() => heart.remove(), 1050);
      }
    }
  </script>
</body>
</html>
